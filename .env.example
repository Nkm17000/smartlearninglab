# Mongo / JWT
MONGODB_URI=mongodb://localhost:27017/smart_learning_lab
JWT_SECRET_KEY=replace-with-a-long-random-secret

# CORS
CORS_ORIGINS=https://smartlearninglab-react.pages.dev,http://localhost:8081,http://127.0.0.1:8081

# Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=smartlearninglab@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=smartlearninglab@gmail.com
SMTP_USE_TLS=true

# Email links
BACKEND_PUBLIC_URL=https://smartlearninglab-526006260073.asia-south1.run.app
FRONTEND_WEB_URL=https://smartlearninglab-react.pages.dev
FRONTEND_MOBILE_SCHEME=smartlearninglab://
EMAIL_VERIFICATION_HOURS=24
PASSWORD_RESET_MINUTES=30

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://smartlearninglab-526006260073.asia-south1.run.app/api/v1/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=https://smartlearninglab-526006260073.asia-south1.run.app/api/v1/auth/github/callback

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Brevo transactional email (Render Free uses HTTPS, not Gmail SMTP)
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Smart Learning Lab

# Cloudflare R2 object storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=smartlearninglab-storage
R2_ENDPOINT_URL=
R2_SIGNED_URL_EXPIRY=900
