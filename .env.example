APP_NAME=Smart Learning Lab API
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

# Put the database name directly in the URI.
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/smart_learning_lab

JWT_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated origins. Use * for initial local testing.
CORS_ORIGINS=*
